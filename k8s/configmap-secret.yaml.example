apiVersion: v1
kind: Secret
metadata:
  name: scoreboard-secret
type: Opaque
stringData:
  OPENROUTER_API_KEY: "sk-or-v1-..."
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: scoreboard-config
data:
  OPENROUTER_BASE_URL: "https://openrouter.ai/api/v1"
  OPENRROUTER_MODEL: "inclusionai/ling-3.0-flash-vl:free"
  DATABASE_URL: "sqlite:////app/data/sports_scoreboard.db"