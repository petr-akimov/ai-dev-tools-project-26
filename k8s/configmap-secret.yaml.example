apiVersion: v1
kind: Secret
metadata:
  name: scoreboard-secret
type: Opaque
stringData:
  OPENROUTER_API_KEY: "gsk_..."
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: scoreboard-config
data:
  OPENROUTER_BASE_URL: "https://api.groq.com/openai/v1"
  OPENROUTER_MODEL: "qwen/qwen3.8-27b"
  DATABASE_URL: "sqlite:////app/data/sports_scoreboard.db"